{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing runner passport details, personal bests, and ASA athletics affiliation",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "province": { "type": "string", "maxLength": 30 },
        "club": { "type": "string", "maxLength": 100 },
        "licenseNumber": { "type": "string", "maxLength": 50 },
        "category": { "type": "string", "maxLength": 50 },
        "pb5k": { "type": "string", "maxLength": 20 },
        "pb10k": { "type": "string", "maxLength": 20 },
        "pbHalf": { "type": "string", "maxLength": 20 },
        "pbFull": { "type": "string", "maxLength": 20 },
        "pbUltra": { "type": "string", "maxLength": 20 },
        "goal": { "type": "string", "maxLength": 200 },
        "favorites": {
          "type": "object",
          "properties": {
            "races": {
              "type": "array",
              "items": { "type": "string" }
            },
            "clubs": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid"]
    },
    "CommunityRace": {
      "title": "CommunityRace",
      "description": "User or club submitted South African running, trail, or cycling race fixture",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "prov": { "type": "string", "maxLength": 10 },
        "city": { "type": "string", "maxLength": 80 },
        "date": { "type": "string", "maxLength": 20 },
        "dist": {
          "type": "array",
          "items": { "type": "string" }
        },
        "discipline": { "type": "string", "maxLength": 30 },
        "organiser": { "type": "string", "maxLength": 120 },
        "site": { "type": "string", "maxLength": 300 },
        "totalAscentM": { "type": "number" },
        "totalDescentM": { "type": "number" },
        "courseType": { "type": "string", "maxLength": 50 },
        "surface": { "type": "string", "maxLength": 80 },
        "cutoffTime": { "type": "string", "maxLength": 30 },
        "waterTablesCount": { "type": "number" },
        "notes": { "type": "string", "maxLength": 500 },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdByName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "prov", "city", "date", "discipline", "createdByUid"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Individual runner profile document keyed by authenticated Firebase user UID"
    },
    "/communityRaces/{raceId}": {
      "schema": "CommunityRace",
      "description": "Community and club submitted South African races and fixtures"
    }
  }
}
