rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserProfile(data) {
      return data.uid is string &&
             data.uid == request.auth.uid &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('province' in data) || (data.province is string && data.province.size() <= 30)) &&
             (!('club' in data) || (data.club is string && data.club.size() <= 100)) &&
             (!('licenseNumber' in data) || (data.licenseNumber is string && data.licenseNumber.size() <= 50)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
             (!('pb5k' in data) || (data.pb5k is string && data.pb5k.size() <= 20)) &&
             (!('pb10k' in data) || (data.pb10k is string && data.pb10k.size() <= 20)) &&
             (!('pbHalf' in data) || (data.pbHalf is string && data.pbHalf.size() <= 20)) &&
             (!('pbFull' in data) || (data.pbFull is string && data.pbFull.size() <= 20)) &&
             (!('pbUltra' in data) || (data.pbUltra is string && data.pbUltra.size() <= 20)) &&
             (!('goal' in data) || (data.goal is string && data.goal.size() <= 200)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50)) &&
             (!('favorites' in data) || data.favorites is map);
    }

    function isValidCommunityRace(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.prov is string && data.prov.size() <= 10 &&
             data.city is string && data.city.size() <= 80 &&
             data.date is string && data.date.size() <= 20 &&
             data.discipline is string && data.discipline.size() <= 30 &&
             data.createdByUid is string && data.createdByUid == request.auth.uid &&
             (!('dist' in data) || (data.dist is list && data.dist.size() <= 10)) &&
             (!('organiser' in data) || (data.organiser is string && data.organiser.size() <= 120)) &&
             (!('site' in data) || (data.site is string && data.site.size() <= 300)) &&
             (!('totalAscentM' in data) || (data.totalAscentM is number)) &&
             (!('totalDescentM' in data) || (data.totalDescentM is number)) &&
             (!('courseType' in data) || (data.courseType is string && data.courseType.size() <= 50)) &&
             (!('surface' in data) || (data.surface is string && data.surface.size() <= 80)) &&
             (!('cutoffTime' in data) || (data.cutoffTime is string && data.cutoffTime.size() <= 30)) &&
             (!('waterTablesCount' in data) || (data.waterTablesCount is number)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 500)) &&
             (!('createdByName' in data) || (data.createdByName is string && data.createdByName.size() <= 100)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);
      allow list: if false;
    }

    match /communityRaces/{raceId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidId(raceId) && isValidCommunityRace(incoming());
      allow update: if isSignedIn() && isValidId(raceId) && incoming().createdByUid == resource.data.createdByUid && isOwner(resource.data.createdByUid) && isValidCommunityRace(incoming());
      allow delete: if isSignedIn() && isValidId(raceId) && isOwner(resource.data.createdByUid);
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
