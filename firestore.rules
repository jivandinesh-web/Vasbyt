rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserProfile(data) {
      return data.uid is string &&
             data.uid == request.auth.uid &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('province' in data) || (data.province is string && data.province.size() <= 30)) &&
             (!('club' in data) || (data.club is string && data.club.size() <= 100)) &&
             (!('licenseNumber' in data) || (data.licenseNumber is string && data.licenseNumber.size() <= 50)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
             (!('pb5k' in data) || (data.pb5k is string && data.pb5k.size() <= 20)) &&
             (!('pb10k' in data) || (data.pb10k is string && data.pb10k.size() <= 20)) &&
             (!('pbHalf' in data) || (data.pbHalf is string && data.pbHalf.size() <= 20)) &&
             (!('pbFull' in data) || (data.pbFull is string && data.pbFull.size() <= 20)) &&
             (!('pbUltra' in data) || (data.pbUltra is string && data.pbUltra.size() <= 20)) &&
             (!('goal' in data) || (data.goal is string && data.goal.size() <= 200)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50)) &&
             (!('favorites' in data) || data.favorites is map);
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);
      allow list: if false;
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
